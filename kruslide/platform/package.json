{
  "name": "kruslide-platform",
  "private": true,
  "version": "0.1.0",
  "description": "KruSlide member platform: LINE login, subscriptions, deck serving from private R2 (Cloudflare Workers + D1 + R2).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node e2e/smoke.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.10.0",
    "@cloudflare/workers-types": "^5.20261128.1",
    "@fontsource/mali": "^5.3.0",
    "@fontsource/sriracha": "^5.3.0",
    "playwright": "1.63",
    "promptpay-qr": "^0.5.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1",
    "wrangler": "^4.169.0"
  }
}
